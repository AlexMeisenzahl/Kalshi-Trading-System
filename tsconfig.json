{
  "compilerOptions": {
    "target":        "ES2022",
    "module":        "commonjs",
    "lib":           ["ES2022"],
    "rootDir":       ".",
    "outDir":        "dist",
    "strict":        true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck":  true,
    "declaration":   true,
    "declarationMap": true,
    "sourceMap":     true
  },
  "include": ["lib/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "target"]
}
